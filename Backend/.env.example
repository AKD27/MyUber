# --- Required ---
# MongoDB connection string (local or Atlas: mongodb+srv://<user>:<password>@<cluster>/driverondemand)
DB_CONNECT=mongodb://127.0.0.1:27017/driverondemand
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=4000
# Frontend address, allowed to call the API with login cookies
CLIENT_URL=http://localhost:5173

# --- Maps ---
# "osm" uses free OpenStreetMap services (no key, fine for testing);
# "google" needs GOOGLE_MAPS_API. Defaults to google only when a key is set.
MAPS_PROVIDER=osm
GOOGLE_MAPS_API=
# Optional self-hosted OSM services (defaults are the public servers)
# PHOTON_URL=https://photon.komoot.io
# OSRM_URL=https://router.project-osrm.org

# --- Business rules (optional) ---
# COMMISSION_PERCENT=10
# How long a driver has to accept a booking request, in ms (default 5 minutes)
# BOOKING_REQUEST_TIMEOUT_MS=300000
# Maximum distance between driver and pickup when searching, in km
# SEARCH_RADIUS_KM=15
# Wrong OTP attempts before starting/ending a trip is locked for 15 minutes
# MAX_OTP_ATTEMPTS=5
# Login/register/forgot-password requests per IP per 15 minutes
# AUTH_RATE_LIMIT_MAX=20

# --- Email for password reset (optional; without it the reset link is printed in this console) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM=Driver on Demand <you@gmail.com>
